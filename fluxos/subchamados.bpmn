        <di:waypoint x="1210" y="688" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="732" y="654" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_7_di" bpmnElement="seta_7">
