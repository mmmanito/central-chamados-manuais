        <di:waypoint x="910" y="462" />
        <di:waypoint x="910" y="688" />
        <di:waypoint x="1210" y="688" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="916" y="654" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_9_di" bpmnElement="seta_9">
        <di:waypoint x="1096" y="588" />
        <di:waypoint x="1096" y="688" />
        <di:waypoint x="1210" y="688" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="604" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_10_di" bpmnElement="seta_10">
        <di:waypoint x="1120" y="562" />
        <di:waypoint x="1262" y="562" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1126" y="528" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_11_di" bpmnElement="seta_11">
        <di:waypoint x="1352" y="688" />
        <di:waypoint x="1372" y="688" />
        <di:waypoint x="1372" y="188" />
        <di:waypoint x="1394" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_12_di" bpmnElement="seta_12">
        <di:waypoint x="1536" y="188" />
        <di:waypoint x="1558" y="188" />
        <di:waypoint x="1558" y="312" />
        <di:waypoint x="1580" y="312" />
      </bpmndi:BPMNEdge>
