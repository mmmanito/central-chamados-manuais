<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_assistencia" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_assistencia">
    <bpmn:participant id="pool_assistencia" name="Assistência técnica e garantia, com reserva e retorno" processRef="proc_assistencia" />
  </bpmn:collaboration>
  <bpmn:process id="proc_assistencia" name="Assistência técnica e garantia, com reserva e retorno" isExecutable="false">
    <bpmn:laneSet id="raias_assistencia">
      <bpmn:lane id="raia_un" name="Unidade">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_est" name="Estoque">
        <bpmn:flowNodeRef>abre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_custo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>volta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>descarte</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_gest" name="Gestor de estoque e compras">
        <bpmn:flowNodeRef>aprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_forn" name="Fornecedor de assistência">
        <bpmn:flowNodeRef>conserta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_glpi" name="Chamado (atendimento)">
        <bpmn:flowNodeRef>pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>soluciona</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Equipamento com defeito">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="abre" name="Envia para assistência (defeito, protocolo, previsão)">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_custo" name="Com custo?">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="aprova" name="Aprova o envio">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_5</bpmn:outgoing>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="recusa" name="Envio recusado">
      <bpmn:incoming>seta_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_res" name="A unidade fica sem?">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reserva" name="Entrega um equipamento da reserva">
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pend" name="Chamado pendente, acompanhamento privado">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="conserta" name="Conserta, troca ou dá o laudo">
      <bpmn:incoming>seta_10</bpmn:incoming>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="retorno" name="Registra o retorno">
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_res2" name="Resultado">
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="volta" name="Volta à unidade (troca: patrimônio novo); a reserva volta">
      <bpmn:incoming>seta_13</bpmn:incoming>
      <bpmn:outgoing>seta_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="descarte" name="Sem conserto: segue para a proposta de descarte">
      <bpmn:incoming>seta_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="soluciona" name="Central soluciona o chamado (a unidade foi atendida)">
      <bpmn:incoming>seta_15</bpmn:incoming>
      <bpmn:outgoing>seta_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fim" name="Unidade atendida">
      <bpmn:incoming>seta_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i" targetRef="abre" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="abre" targetRef="g_custo" />
    <bpmn:sequenceFlow id="seta_3" name="Sim, sem ser o Gestor" sourceRef="g_custo" targetRef="aprova" />
    <bpmn:sequenceFlow id="seta_4" name="Não" sourceRef="g_custo" targetRef="g_res" />
    <bpmn:sequenceFlow id="seta_5" name="Aprova" sourceRef="aprova" targetRef="g_res" />
    <bpmn:sequenceFlow id="seta_6" name="Recusa" sourceRef="aprova" targetRef="recusa" />
    <bpmn:sequenceFlow id="seta_7" name="Sim" sourceRef="g_res" targetRef="reserva" />
    <bpmn:sequenceFlow id="seta_8" name="Não" sourceRef="g_res" targetRef="pend" />
    <bpmn:sequenceFlow id="seta_9" sourceRef="reserva" targetRef="pend" />
    <bpmn:sequenceFlow id="seta_10" sourceRef="pend" targetRef="conserta" />
    <bpmn:sequenceFlow id="seta_11" sourceRef="conserta" targetRef="retorno" />
    <bpmn:sequenceFlow id="seta_12" sourceRef="retorno" targetRef="g_res2" />
    <bpmn:sequenceFlow id="seta_13" name="Consertado ou trocado" sourceRef="g_res2" targetRef="volta" />
    <bpmn:sequenceFlow id="seta_14" name="Sem conserto" sourceRef="g_res2" targetRef="descarte" />
    <bpmn:sequenceFlow id="seta_15" sourceRef="volta" targetRef="soluciona" />
    <bpmn:sequenceFlow id="seta_16" sourceRef="soluciona" targetRef="fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_assistencia">
    <bpmndi:BPMNPlane id="plano_assistencia" bpmnElement="colab_assistencia">
      <bpmndi:BPMNShape id="pool_assistencia_di" bpmnElement="pool_assistencia" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2308" height="750" />
