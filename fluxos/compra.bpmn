<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_compra" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_compra">
    <bpmn:participant id="pool_compra" name="Compra: do pedido à compra, com propostas, avaliação do Gestor e escolha do Financeiro" processRef="proc_compra" />
  </bpmn:collaboration>
  <bpmn:process id="proc_compra" name="Compra: do pedido à compra, com propostas, avaliação do Gestor e escolha do Financeiro" isExecutable="false">
    <bpmn:laneSet id="raias_compra">
      <bpmn:lane id="raia_un" name="Unidade">
        <bpmn:flowNodeRef>i_un</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_glpi" name="Chamado (atendimento)">
        <bpmn:flowNodeRef>classif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_est" name="Estoque">
        <bpmn:flowNodeRef>i_est</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f_rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_comp" name="Compras">
        <bpmn:flowNodeRef>itens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propostas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>justif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_gest" name="Gestor de estoque e compras">
        <bpmn:flowNodeRef>avalia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_gest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>devolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusa_g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_fin" name="Financeiro">
        <bpmn:flowNodeRef>escolhe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusa_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_forn" name="Fornecedor">
        <bpmn:flowNodeRef>responde</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i_un" name="Precisa de um item">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="abre" name="Abre o chamado no aplicativo">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="classif" name="Técnico abre o subchamado de aquisição">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="auto" name="Central abre o pedido; o chamado aguarda">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="i_est" name="Estoque mínimo (Pedir compra) ou requisição">
      <bpmn:outgoing>seta_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="itens" name="Inclui os itens">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="solic" name="Gera a solicitação de cotação (PDF) e envia">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="responde" name="Envia a proposta">
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="propostas" name="Registra ou revisa as propostas (marca e modelo, frete, validade, pagamento)">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:incoming>seta_18</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_tres" name="Mínimo de propostas?">
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="justif" name="Escreve a justificativa da exceção">
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="enviar" name="Envia ao Gestor">
      <bpmn:incoming>seta_10</bpmn:incoming>
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="avalia" name="Homologa ou recusa cada proposta e marca as recomendadas">
      <bpmn:incoming>seta_13</bpmn:incoming>
      <bpmn:incoming>seta_21</bpmn:incoming>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_gest" name="Decisão do Gestor">
      <bpmn:incoming>seta_14</bpmn:incoming>
      <bpmn:outgoing>seta_15</bpmn:outgoing>
      <bpmn:outgoing>seta_16</bpmn:outgoing>
      <bpmn:outgoing>seta_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="devolve" name="Devolve para completar as cotações (as homologadas valem)">
      <bpmn:incoming>seta_16</bpmn:incoming>
      <bpmn:outgoing>seta_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="recusa_g" name="Recusado: o chamado recebe o motivo e é fechado">
      <bpmn:incoming>seta_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="escolhe" name="Escolhe a proposta e a condição de pagamento (tela ou papel)">
      <bpmn:incoming>seta_15</bpmn:incoming>
      <bpmn:outgoing>seta_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_fin" name="Autoriza?">
      <bpmn:incoming>seta_19</bpmn:incoming>
      <bpmn:outgoing>seta_20</bpmn:outgoing>
      <bpmn:outgoing>seta_21</bpmn:outgoing>
      <bpmn:outgoing>seta_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="recusa_f" name="Recusado: o chamado recebe o motivo e é fechado">
      <bpmn:incoming>seta_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="compra" name="Registra a compra (pedido e previsão)">
      <bpmn:incoming>seta_20</bpmn:incoming>
      <bpmn:outgoing>seta_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="aviso" name="Aviso da entrega prevista ao Estoque">
      <bpmn:incoming>seta_23</bpmn:incoming>
      <bpmn:outgoing>seta_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="f_rec" name="Segue: recebimento e entrega">
      <bpmn:incoming>seta_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i_un" targetRef="abre" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="abre" targetRef="classif" />
    <bpmn:sequenceFlow id="seta_3" sourceRef="classif" targetRef="auto" />
    <bpmn:sequenceFlow id="seta_4" sourceRef="auto" targetRef="itens" />
    <bpmn:sequenceFlow id="seta_5" sourceRef="i_est" targetRef="itens" />
    <bpmn:sequenceFlow id="seta_6" sourceRef="itens" targetRef="solic" />
    <bpmn:sequenceFlow id="seta_7" sourceRef="solic" targetRef="responde" />
    <bpmn:sequenceFlow id="seta_8" sourceRef="responde" targetRef="propostas" />
    <bpmn:sequenceFlow id="seta_9" sourceRef="propostas" targetRef="g_tres" />
    <bpmn:sequenceFlow id="seta_10" name="Sim" sourceRef="g_tres" targetRef="enviar" />
    <bpmn:sequenceFlow id="seta_11" name="Não" sourceRef="g_tres" targetRef="justif" />
    <bpmn:sequenceFlow id="seta_12" sourceRef="justif" targetRef="enviar" />
    <bpmn:sequenceFlow id="seta_13" sourceRef="enviar" targetRef="avalia" />
    <bpmn:sequenceFlow id="seta_14" sourceRef="avalia" targetRef="g_gest" />
    <bpmn:sequenceFlow id="seta_15" name="Envia ao Financeiro" sourceRef="g_gest" targetRef="escolhe" />
    <bpmn:sequenceFlow id="seta_16" name="Faltam cotações" sourceRef="g_gest" targetRef="devolve" />
    <bpmn:sequenceFlow id="seta_17" name="Recusa a compra" sourceRef="g_gest" targetRef="recusa_g" />
    <bpmn:sequenceFlow id="seta_18" name="novas propostas" sourceRef="devolve" targetRef="propostas" />
    <bpmn:sequenceFlow id="seta_19" sourceRef="escolhe" targetRef="g_fin" />
    <bpmn:sequenceFlow id="seta_20" name="Sim" sourceRef="g_fin" targetRef="compra" />
    <bpmn:sequenceFlow id="seta_21" name="Devolve ao Gestor" sourceRef="g_fin" targetRef="avalia" />
    <bpmn:sequenceFlow id="seta_22" name="Recusa a compra" sourceRef="g_fin" targetRef="recusa_f" />
    <bpmn:sequenceFlow id="seta_23" sourceRef="compra" targetRef="aviso" />
    <bpmn:sequenceFlow id="seta_24" sourceRef="aviso" targetRef="f_rec" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_compra">
    <bpmndi:BPMNPlane id="plano_compra" bpmnElement="colab_compra">
      <bpmndi:BPMNShape id="pool_compra_di" bpmnElement="pool_compra" isHorizontal="true">
