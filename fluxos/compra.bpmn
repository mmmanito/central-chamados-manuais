<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_compra" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_compra">
    <bpmn:participant id="pool_compra" name="Compra em lote (5.3.0): da fila ao pedido, com orçamentos e autorização da diretoria" processRef="proc_compra" />
  </bpmn:collaboration>
  <bpmn:process id="proc_compra" name="Compra em lote (5.3.0): da fila ao pedido, com orçamentos e autorização da diretoria" isExecutable="false">
    <bpmn:laneSet id="raias_compra">
      <bpmn:lane id="raia_un" name="Unidade">
        <bpmn:flowNodeRef>i_un</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_glpi" name="Chamado (atendimento)">
        <bpmn:flowNodeRef>classif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_est" name="Estoque">
        <bpmn:flowNodeRef>i_est</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f_rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_comp" name="Compras">
        <bpmn:flowNodeRef>itens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propostas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>justif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>devolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusa_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anexa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_fin" name="Diretoria (Financeiro, no papel)">
        <bpmn:flowNodeRef>g_gest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assina_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_forn" name="Fornecedor">
        <bpmn:flowNodeRef>responde</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i_un" name="Precisa de um item">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="abre" name="Abre o chamado">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="classif" name="Técnico: Deixar pendente › Pendente de compras (lista os itens)">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="auto" name="Itens vão para a fila; o chamado aguarda">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="i_est" name="Estoque mínimo (Pedir compra) ou requisição">
      <bpmn:outgoing>seta_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="itens" name="Monta o pedido com itens de vários chamados">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="responde" name="Envia o orçamento (PDF ou anúncio)">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="propostas" name="Anexa cada proposta: fornecedor, valor total e nº do orçamento">
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:incoming>seta_16</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_tres" name="Mínimo de propostas?">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="justif" name="Escreve a justificativa da exceção">
      <bpmn:incoming>seta_10</bpmn:incoming>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="enviar" name="Escolhe a mais vantajosa, gera o espelho e leva à diretoria">
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_gest" name="Diretoria autoriza?">
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
      <bpmn:outgoing>seta_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="devolve" name="Volta para a cotação">
      <bpmn:incoming>seta_14</bpmn:incoming>
      <bpmn:outgoing>seta_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="recusa_g" name="Cancelado: o chamado recebe o motivo">
      <bpmn:incoming>seta_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="assina_fin" name="Assina Autorização Financeiro e a proposta">
      <bpmn:incoming>seta_13</bpmn:incoming>
      <bpmn:outgoing>seta_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="anexa" name="Anexa os documentos assinados (qualquer pessoa de Compras)">
      <bpmn:incoming>seta_17</bpmn:incoming>
      <bpmn:outgoing>seta_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="compra" name="Registra a compra (pedido e previsão)">
      <bpmn:incoming>seta_18</bpmn:incoming>
      <bpmn:outgoing>seta_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="aviso" name="Aviso da entrega prevista ao Estoque">
      <bpmn:incoming>seta_19</bpmn:incoming>
      <bpmn:outgoing>seta_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="f_rec" name="Segue: recebimento; cada chamado volta ao técnico">
      <bpmn:incoming>seta_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i_un" targetRef="abre" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="abre" targetRef="classif" />
    <bpmn:sequenceFlow id="seta_3" sourceRef="classif" targetRef="auto" />
    <bpmn:sequenceFlow id="seta_4" sourceRef="auto" targetRef="itens" />
    <bpmn:sequenceFlow id="seta_5" sourceRef="i_est" targetRef="itens" />
    <bpmn:sequenceFlow id="seta_6" sourceRef="itens" targetRef="responde" />
    <bpmn:sequenceFlow id="seta_7" sourceRef="responde" targetRef="propostas" />
    <bpmn:sequenceFlow id="seta_8" sourceRef="propostas" targetRef="g_tres" />
    <bpmn:sequenceFlow id="seta_9" name="Sim" sourceRef="g_tres" targetRef="enviar" />
    <bpmn:sequenceFlow id="seta_10" name="Não" sourceRef="g_tres" targetRef="justif" />
    <bpmn:sequenceFlow id="seta_11" sourceRef="justif" targetRef="enviar" />
    <bpmn:sequenceFlow id="seta_12" name="espelho" sourceRef="enviar" targetRef="g_gest" />
    <bpmn:sequenceFlow id="seta_13" name="Sim" sourceRef="g_gest" targetRef="assina_fin" />
    <bpmn:sequenceFlow id="seta_14" name="Outra proposta" sourceRef="g_gest" targetRef="devolve" />
    <bpmn:sequenceFlow id="seta_15" name="Não" sourceRef="g_gest" targetRef="recusa_g" />
    <bpmn:sequenceFlow id="seta_16" name="novas propostas" sourceRef="devolve" targetRef="propostas" />
    <bpmn:sequenceFlow id="seta_17" name="escaneado" sourceRef="assina_fin" targetRef="anexa" />
    <bpmn:sequenceFlow id="seta_18" sourceRef="anexa" targetRef="compra" />
    <bpmn:sequenceFlow id="seta_19" sourceRef="compra" targetRef="aviso" />
    <bpmn:sequenceFlow id="seta_20" sourceRef="aviso" targetRef="f_rec" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_compra">
    <bpmndi:BPMNPlane id="plano_compra" bpmnElement="colab_compra">
      <bpmndi:BPMNShape id="pool_compra_di" bpmnElement="pool_compra" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="3048" height="1000" />
