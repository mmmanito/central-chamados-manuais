<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_saida" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_saida">
    <bpmn:participant id="pool_saida" name="Saída e descarte com evidências (um ou vários equipamentos num lote)" processRef="proc_saida" />
  </bpmn:collaboration>
  <bpmn:process id="proc_saida" name="Saída e descarte com evidências (um ou vários equipamentos num lote)" isExecutable="false">
    <bpmn:laneSet id="raias_saida">
      <bpmn:lane id="raia_tec" name="Técnico">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>laudo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_est" name="Estoque">
        <bpmn:flowNodeRef>propoe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>baixa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>termo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_gest" name="Gestor de estoque e compras">
        <bpmn:flowNodeRef>analisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>volta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Equipamento sai do patrimônio">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="laudo" name="Escreve o laudo técnico">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="propoe" name="Propõe a saída (motivo, laudo, itens)">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="analisa" name="Analisa a proposta e o laudo">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aprova" name="Aprova?">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:outgoing>seta_5</bpmn:outgoing>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="volta" name="Recusada: os itens voltam à situação anterior">
      <bpmn:incoming>seta_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="evid" name="Anexa as evidências exigidas pelo motivo">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="conclui" name="Conclui: destinatário e data">
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="baixa" name="Itens Descartados (histórico mantido)">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="termo" name="Imprime o termo de saída e colhe a assinatura">
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fim" name="Saída concluída">
      <bpmn:incoming>seta_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i" targetRef="laudo" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="laudo" targetRef="propoe" />
    <bpmn:sequenceFlow id="seta_3" name="proposta pelo Estoque" sourceRef="propoe" targetRef="analisa" />
    <bpmn:sequenceFlow id="seta_4" sourceRef="analisa" targetRef="g_aprova" />
    <bpmn:sequenceFlow id="seta_5" name="Não" sourceRef="g_aprova" targetRef="volta" />
    <bpmn:sequenceFlow id="seta_6" name="Sim" sourceRef="g_aprova" targetRef="evid" />
    <bpmn:sequenceFlow id="seta_7" sourceRef="evid" targetRef="conclui" />
    <bpmn:sequenceFlow id="seta_8" sourceRef="conclui" targetRef="baixa" />
    <bpmn:sequenceFlow id="seta_9" sourceRef="baixa" targetRef="termo" />
    <bpmn:sequenceFlow id="seta_10" sourceRef="termo" targetRef="fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_saida">
    <bpmndi:BPMNPlane id="plano_saida" bpmnElement="colab_saida">
      <bpmndi:BPMNShape id="pool_saida_di" bpmnElement="pool_saida" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1938" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raia_tec_di" bpmnElement="raia_tec" isHorizontal="true">
        <dc:Bounds x="34" y="0" width="1904" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raia_est_di" bpmnElement="raia_est" isHorizontal="true">
        <dc:Bounds x="34" y="125" width="1904" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raia_gest_di" bpmnElement="raia_gest" isHorizontal="true">
        <dc:Bounds x="34" y="375" width="1904" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_di" bpmnElement="i">
        <dc:Bounds x="152" y="44" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="110" y="84" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laudo_di" bpmnElement="laudo">
        <dc:Bounds x="284" y="22" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="propoe_di" bpmnElement="propoe">
        <dc:Bounds x="470" y="146" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="analisa_di" bpmnElement="analisa">
        <dc:Bounds x="654" y="396" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_aprova_di" bpmnElement="g_aprova" isMarkerVisible="true">
        <dc:Bounds x="886" y="412" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="380" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="volta_di" bpmnElement="volta">
        <dc:Bounds x="1078" y="420" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1036" y="460" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evid_di" bpmnElement="evid">
        <dc:Bounds x="1024" y="272" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conclui_di" bpmnElement="conclui">
        <dc:Bounds x="1210" y="272" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="baixa_di" bpmnElement="baixa">
        <dc:Bounds x="1394" y="146" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="termo_di" bpmnElement="termo">
        <dc:Bounds x="1580" y="146" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
        <dc:Bounds x="1818" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1776" y="210" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seta_1_di" bpmnElement="seta_1">
        <di:waypoint x="188" y="62" />
        <di:waypoint x="284" y="62" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_2_di" bpmnElement="seta_2">
        <di:waypoint x="426" y="62" />
        <di:waypoint x="448" y="62" />
        <di:waypoint x="448" y="188" />
        <di:waypoint x="470" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_3_di" bpmnElement="seta_3">
        <di:waypoint x="612" y="188" />
        <di:waypoint x="632" y="188" />
        <di:waypoint x="632" y="438" />
        <di:waypoint x="654" y="438" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="294" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_4_di" bpmnElement="seta_4">
        <di:waypoint x="796" y="438" />
        <di:waypoint x="886" y="438" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_5_di" bpmnElement="seta_5">
        <di:waypoint x="936" y="438" />
        <di:waypoint x="1078" y="438" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="942" y="404" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_6_di" bpmnElement="seta_6">
        <di:waypoint x="910" y="412" />
        <di:waypoint x="910" y="312" />
        <di:waypoint x="1024" y="312" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="916" y="382" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_7_di" bpmnElement="seta_7">
        <di:waypoint x="1166" y="312" />
        <di:waypoint x="1210" y="312" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_8_di" bpmnElement="seta_8">
        <di:waypoint x="1352" y="312" />
        <di:waypoint x="1372" y="312" />
        <di:waypoint x="1372" y="188" />
        <di:waypoint x="1394" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_9_di" bpmnElement="seta_9">
        <di:waypoint x="1536" y="188" />
        <di:waypoint x="1580" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seta_10_di" bpmnElement="seta_10">
        <di:waypoint x="1722" y="188" />
        <di:waypoint x="1818" y="188" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
