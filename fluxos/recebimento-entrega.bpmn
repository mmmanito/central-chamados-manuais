<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_recebimento-entrega" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_recebimento-entrega">
    <bpmn:participant id="pool_recebimento-entrega" name="Recebimento e entrega, com a solução do chamado de origem" processRef="proc_recebimento-entrega" />
  </bpmn:collaboration>
  <bpmn:process id="proc_recebimento-entrega" name="Recebimento e entrega, com a solução do chamado de origem" isExecutable="false">
    <bpmn:laneSet id="raias_recebimento-entrega">
      <bpmn:lane id="raia_resp" name="Estoque">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tudo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_para</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_comp" name="Compras">
        <bpmn:flowNodeRef>diverg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_tec" name="Técnico">
        <bpmn:flowNodeRef>leva</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_un" name="Unidade">
        <bpmn:flowNodeRef>assina</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_glpi" name="Chamado (atendimento)">
        <bpmn:flowNodeRef>soluciona</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Fornecedor entregou">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="receb" name="Confere e registra o recebimento (séries, nota e garantia)">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="diverg" name="Resolve a divergência com o fornecedor (troca, complemento ou devolução)">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pat" name="Central gera os patrimônios; itens em estoque no almoxarifado">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_tudo" name="Recebeu tudo?">
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_para" name="Compra para quem?">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="leva" name="Leva os itens à unidade">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="registra" name="Registra a entrega e imprime o termo">
      <bpmn:incoming>seta_10</bpmn:incoming>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="assina" name="Assina o termo de entrega">
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="soluciona" name="Central soluciona o chamado (itens e patrimônios, sem valores)">
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_conf" name="Confirma a solução?">
      <bpmn:incoming>seta_13</bpmn:incoming>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
      <bpmn:outgoing>seta_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fecha" name="Chamado fechado">
      <bpmn:incoming>seta_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="recusa" name="Recusa com motivo: o chamado volta à equipe">
      <bpmn:incoming>seta_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i" targetRef="receb" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="receb" targetRef="pat" />
    <bpmn:sequenceFlow id="seta_3" name="divergência (quantidade, modelo, defeito)" sourceRef="receb" targetRef="diverg" />
    <bpmn:sequenceFlow id="seta_4" name="troca ou complemento" sourceRef="diverg" targetRef="receb" />
    <bpmn:sequenceFlow id="seta_5" sourceRef="pat" targetRef="g_tudo" />
    <bpmn:sequenceFlow id="seta_6" name="Sim" sourceRef="g_tudo" targetRef="g_para" />
    <bpmn:sequenceFlow id="seta_7" name="Não: aguarda o restante" sourceRef="g_tudo" targetRef="receb" />
    <bpmn:sequenceFlow id="seta_8" name="Unidade" sourceRef="g_para" targetRef="leva" />
    <bpmn:sequenceFlow id="seta_9" name="Almoxarifado (reposição)" sourceRef="g_para" targetRef="soluciona" />
    <bpmn:sequenceFlow id="seta_10" sourceRef="leva" targetRef="registra" />
    <bpmn:sequenceFlow id="seta_11" sourceRef="registra" targetRef="assina" />
    <bpmn:sequenceFlow id="seta_12" sourceRef="assina" targetRef="soluciona" />
    <bpmn:sequenceFlow id="seta_13" sourceRef="soluciona" targetRef="g_conf" />
    <bpmn:sequenceFlow id="seta_14" name="Sim" sourceRef="g_conf" targetRef="fecha" />
    <bpmn:sequenceFlow id="seta_15" name="Não" sourceRef="g_conf" targetRef="recusa" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_recebimento-entrega">
    <bpmndi:BPMNPlane id="plano_recebimento-entrega" bpmnElement="colab_recebimento-entrega">
      <bpmndi:BPMNShape id="pool_recebimento-entrega_di" bpmnElement="pool_recebimento-entrega" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2308" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raia_resp_di" bpmnElement="raia_resp" isHorizontal="true">
        <dc:Bounds x="34" y="0" width="2274" height="125" />
      </bpmndi:BPMNShape>
