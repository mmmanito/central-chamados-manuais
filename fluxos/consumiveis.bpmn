          <dc:Bounds x="1220" y="334" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saldo_di" bpmnElement="saldo">
        <dc:Bounds x="1210" y="22" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_min_di" bpmnElement="g_min" isMarkerVisible="true">
        <dc:Bounds x="1440" y="38" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1338" y="6" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pedir_di" bpmnElement="pedir">
        <dc:Bounds x="1580" y="146" width="142" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f_compra_di" bpmnElement="f_compra">
        <dc:Bounds x="1818" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1776" y="210" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
        <dc:Bounds x="1818" y="44" width="36" height="36" />
