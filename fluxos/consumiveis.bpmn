<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_consumiveis" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_consumiveis">
    <bpmn:participant id="pool_consumiveis" name="Consumíveis: entrada, saída e ajuste com aprovação" processRef="proc_consumiveis" />
  </bpmn:collaboration>
  <bpmn:process id="proc_consumiveis" name="Consumíveis: entrada, saída e ajuste com aprovação" isExecutable="false">
    <bpmn:laneSet id="raias_consumiveis">
      <bpmn:lane id="raia_resp" name="Estoque">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pede</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_min</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pedir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f_compra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_gest" name="Gestor de estoque e compras">
        <bpmn:flowNodeRef>analisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recusado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Movimento de consumível">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_tipo" name="Tipo">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="es" name="Informa item, almoxarifado e quantidade">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_pede" name="Pede aprovação?">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:outgoing>seta_5</bpmn:outgoing>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="conta" name="Informa a contagem e o motivo">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="analisa" name="Analisa o pedido">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aprova" name="Aprova?">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="recusado" name="Recusado (fica registrado)">
      <bpmn:incoming>seta_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saldo" name="Saldo atualizado pela movimentação (nunca editado à mão)">
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_min" name="Abaixo do mínimo?">
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pedir" name="Pedir compra (quantidade que falta)">
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="f_compra" name="Pedido de compra aberto">
      <bpmn:incoming>seta_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fim" name="Saldo em dia">
      <bpmn:incoming>seta_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i" targetRef="g_tipo" />
    <bpmn:sequenceFlow id="seta_2" name="Entrada ou saída" sourceRef="g_tipo" targetRef="es" />
    <bpmn:sequenceFlow id="seta_3" name="Ajuste" sourceRef="g_tipo" targetRef="conta" />
    <bpmn:sequenceFlow id="seta_4" sourceRef="es" targetRef="g_pede" />
    <bpmn:sequenceFlow id="seta_5" name="Não" sourceRef="g_pede" targetRef="saldo" />
    <bpmn:sequenceFlow id="seta_6" name="Sim" sourceRef="g_pede" targetRef="analisa" />
    <bpmn:sequenceFlow id="seta_7" name="sempre pede" sourceRef="conta" targetRef="analisa" />
    <bpmn:sequenceFlow id="seta_8" sourceRef="analisa" targetRef="g_aprova" />
    <bpmn:sequenceFlow id="seta_9" name="Sim" sourceRef="g_aprova" targetRef="saldo" />
    <bpmn:sequenceFlow id="seta_10" name="Não" sourceRef="g_aprova" targetRef="recusado" />
    <bpmn:sequenceFlow id="seta_11" sourceRef="saldo" targetRef="g_min" />
    <bpmn:sequenceFlow id="seta_12" name="Sim" sourceRef="g_min" targetRef="pedir" />
    <bpmn:sequenceFlow id="seta_13" name="Não" sourceRef="g_min" targetRef="fim" />
    <bpmn:sequenceFlow id="seta_14" sourceRef="pedir" targetRef="f_compra" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_consumiveis">
    <bpmndi:BPMNPlane id="plano_consumiveis" bpmnElement="colab_consumiveis">
      <bpmndi:BPMNShape id="pool_consumiveis_di" bpmnElement="pool_consumiveis" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1938" height="375" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raia_resp_di" bpmnElement="raia_resp" isHorizontal="true">
