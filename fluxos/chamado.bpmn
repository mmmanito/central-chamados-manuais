<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_chamado" targetNamespace="https://central-chamados/fluxos" exporter="Central de Chamados" exporterVersion="4.9.0">
  <bpmn:collaboration id="colab_chamado">
    <bpmn:participant id="pool_chamado" name="Ciclo de vida do chamado (5.0): da abertura no aplicativo ao fechamento" processRef="proc_chamado" />
  </bpmn:collaboration>
  <bpmn:process id="proc_chamado" name="Ciclo de vida do chamado (5.0): da abertura no aplicativo ao fechamento" isExecutable="false">
    <bpmn:laneSet id="raias_chamado">
      <bpmn:lane id="raia_un" name="Usuário ou gerente">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avalia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_central" name="Central">
        <bpmn:flowNodeRef>g_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fila</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fecha</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_tri" name="Triagem">
        <bpmn:flowNodeRef>triagem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_tec" name="Técnico">
        <bpmn:flowNodeRef>assume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solucao</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Problema ou pedido">
      <bpmn:outgoing>seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="abre" name="Abre o chamado no aplicativo (texto, fotos)">
      <bpmn:incoming>seta_1</bpmn:incoming>
      <bpmn:outgoing>seta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_tri" name="Triagem ligada?">
      <bpmn:incoming>seta_2</bpmn:incoming>
      <bpmn:outgoing>seta_3</bpmn:outgoing>
      <bpmn:outgoing>seta_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="triagem" name="Direciona ao grupo ou ao técnico">
      <bpmn:incoming>seta_3</bpmn:incoming>
      <bpmn:outgoing>seta_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="fila" name="Na fila do grupo (faixa Na fila, sem técnico)">
      <bpmn:incoming>seta_4</bpmn:incoming>
      <bpmn:incoming>seta_5</bpmn:incoming>
      <bpmn:outgoing>seta_6</bpmn:outgoing>
      <bpmn:outgoing>seta_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="cancela" name="Cancela antes da solução, com o motivo">
      <bpmn:incoming>seta_22</bpmn:incoming>
      <bpmn:outgoing>seta_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="f_canc" name="Cancelado (definitivo)">
      <bpmn:incoming>seta_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="assume" name="Assume e classifica (tipo e categoria)">
      <bpmn:incoming>seta_6</bpmn:incoming>
      <bpmn:outgoing>seta_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="atende" name="Inicia (ou planeja) e atende">
      <bpmn:incoming>seta_7</bpmn:incoming>
      <bpmn:incoming>seta_10</bpmn:incoming>
      <bpmn:incoming>seta_13</bpmn:incoming>
      <bpmn:incoming>seta_18</bpmn:incoming>
      <bpmn:outgoing>seta_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_pend" name="Precisa do usuário ou de fornecedor?">
      <bpmn:incoming>seta_8</bpmn:incoming>
      <bpmn:outgoing>seta_9</bpmn:outgoing>
      <bpmn:outgoing>seta_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_sub" name="Depende de outra parte?">
      <bpmn:incoming>seta_11</bpmn:incoming>
      <bpmn:outgoing>seta_12</bpmn:outgoing>
      <bpmn:outgoing>seta_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pend" name="Pendente (o SLA pausa)">
      <bpmn:incoming>seta_9</bpmn:incoming>
      <bpmn:outgoing>seta_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sub" name="Abre subchamado (fluxo de subchamados)">
      <bpmn:incoming>seta_12</bpmn:incoming>
      <bpmn:outgoing>seta_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="solucao" name="Registra a solução">
      <bpmn:incoming>seta_14</bpmn:incoming>
      <bpmn:outgoing>seta_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="avisa" name="Avisa: sino, push, e-mail reserva">
      <bpmn:incoming>seta_15</bpmn:incoming>
      <bpmn:outgoing>seta_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_aprova" name="Resolveu?">
      <bpmn:incoming>seta_16</bpmn:incoming>
      <bpmn:outgoing>seta_17</bpmn:outgoing>
      <bpmn:outgoing>seta_18</bpmn:outgoing>
      <bpmn:outgoing>seta_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="avalia" name="Dá as estrelas">
      <bpmn:incoming>seta_17</bpmn:incoming>
      <bpmn:outgoing>seta_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="auto" name="Sem resposta em N dias úteis: fecha sozinho">
      <bpmn:incoming>seta_19</bpmn:incoming>
      <bpmn:outgoing>seta_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fecha" name="Fechado (definitivo)">
      <bpmn:incoming>seta_20</bpmn:incoming>
      <bpmn:incoming>seta_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="seta_1" sourceRef="i" targetRef="abre" />
    <bpmn:sequenceFlow id="seta_2" sourceRef="abre" targetRef="g_tri" />
    <bpmn:sequenceFlow id="seta_3" name="Sim" sourceRef="g_tri" targetRef="triagem" />
    <bpmn:sequenceFlow id="seta_4" name="Não" sourceRef="g_tri" targetRef="fila" />
    <bpmn:sequenceFlow id="seta_5" sourceRef="triagem" targetRef="fila" />
    <bpmn:sequenceFlow id="seta_6" sourceRef="fila" targetRef="assume" />
    <bpmn:sequenceFlow id="seta_7" sourceRef="assume" targetRef="atende" />
    <bpmn:sequenceFlow id="seta_8" sourceRef="atende" targetRef="g_pend" />
    <bpmn:sequenceFlow id="seta_9" name="Sim" sourceRef="g_pend" targetRef="pend" />
    <bpmn:sequenceFlow id="seta_10" name="Retoma" sourceRef="pend" targetRef="atende" />
    <bpmn:sequenceFlow id="seta_11" name="Não" sourceRef="g_pend" targetRef="g_sub" />
    <bpmn:sequenceFlow id="seta_12" name="Sim" sourceRef="g_sub" targetRef="sub" />
    <bpmn:sequenceFlow id="seta_13" name="os filhos terminam" sourceRef="sub" targetRef="atende" />
    <bpmn:sequenceFlow id="seta_14" name="Não" sourceRef="g_sub" targetRef="solucao" />
    <bpmn:sequenceFlow id="seta_15" sourceRef="solucao" targetRef="avisa" />
    <bpmn:sequenceFlow id="seta_16" sourceRef="avisa" targetRef="g_aprova" />
    <bpmn:sequenceFlow id="seta_17" name="Sim" sourceRef="g_aprova" targetRef="avalia" />
    <bpmn:sequenceFlow id="seta_18" name="Não: volta ao atendimento" sourceRef="g_aprova" targetRef="atende" />
    <bpmn:sequenceFlow id="seta_19" name="sem resposta" sourceRef="g_aprova" targetRef="auto" />
    <bpmn:sequenceFlow id="seta_20" sourceRef="avalia" targetRef="fecha" />
    <bpmn:sequenceFlow id="seta_21" sourceRef="auto" targetRef="fecha" />
    <bpmn:sequenceFlow id="seta_22" name="o usuário desiste" sourceRef="fila" targetRef="cancela" />
    <bpmn:sequenceFlow id="seta_23" sourceRef="cancela" targetRef="f_canc" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_chamado">
    <bpmndi:BPMNPlane id="plano_chamado" bpmnElement="colab_chamado">
